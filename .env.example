# Copy to .env in the repo root and fill in; .env is git-ignored.
# `python -m rk` loads it at startup. Variables already set in the environment win.

# LLM calls (paraphraser, judge, agent) go through OpenRouter, and so do the OpenAI and
# Perplexity systems of `python -m rk compete`.
OPENROUTER_API_KEY=
# `python -m rk compete`: Claude with Anthropic's web search tool (Messages API).
ANTHROPIC_API_KEY=
# Optional: a free Semantic Scholar API key (1 request/s of your own). Keyless requests
# share one pool, which answered most of our probes with HTTP 429.
SEMANTIC_SCHOLAR_API_KEY=
# Optional: an email address for Crossref's polite pool (checking that listed papers exist).
CROSSREF_MAILTO=
# Optional, but a free OpenAlex key gives 10x the keyless daily budget.
OPENALEX_API_KEY=
# Optional; OpenAlex has ignored mailto since February 2026.
OPENALEX_MAILTO=
